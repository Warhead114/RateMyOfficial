# Variable names only. Supply values through your trusted runtime/secret manager.
# The application reads process.env; this file is not automatically loaded.
# Never use a Production database or Production secrets in Development.
DATABASE_URL=
SESSION_SECRET=
APP_URL=

# Delivery is disabled by default. This template does not authorize activation.
EMAIL_DELIVERY_MODE=off
EMAIL_WORKER_ENABLED=0
EMAIL_VALIDATION_ENABLED=0
POSTMARK_SERVER_TOKEN=
EMAIL_SENSITIVE_PAYLOAD_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
POSTMARK_MESSAGE_STREAM=
